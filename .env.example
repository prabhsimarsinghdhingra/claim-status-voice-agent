# Free key: https://aistudio.google.com/apikey  (no credit card)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_FALLBACK_MODELS=gemini-3.6-flash   # run `python -m csva doctor` to list models your key can use
CSVA_RPM=8                           # max requests/minute; free-tier limits are per project, check AI Studio
CSVA_BRAIN=rules                     # rules | gemini  (used by the Twilio server)
CSVA_DB=calls.db
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
